# Token que o atalho do iPhone manda no header X-Malais-Token.
# Gera um aleatório: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Vazio desliga a autenticação — só faça isso em teste local.
MALAIS_TOKEN=

# Chave da Groq (console.groq.com). Deixe vazio pra rodar em modo eco.
GROQ_API_KEY=
MODELO=openai/gpt-oss-120b

# Raciocínio do gpt-oss: low, medium ou high. O padrão da Groq é medium, que
# custa segundos até numa pergunta boba — low respeita o orçamento de 5s.
# Deixe VAZIO se trocar por um modelo que não raciocina, senão a API dá 400.
ESFORCO_RACIOCINIO=low

FUSO=America/Sao_Paulo

# Memória curta: quantas trocas anteriores ele leva em conta, e por quanto tempo.
# Serve pra "na verdade era chá" funcionar logo depois de "anota que preciso
# comprar café". Cada troca a mais custa tokens em TODA chamada. 0 desliga.
MEMORIA_VOLTAS=3
MEMORIA_MINUTOS=30

# Porta do servidor. Padrão 8000.
PORTA=8000

# Caminho do SQLite. Padrão: malais.db na raiz do projeto.
# BANCO=/root/malais/malais.db
